@using SGA.Application.DTOs.Horario
@model IEnumerable<HorarioDto>

@{
    ViewData["Title"] = "Index";
}

<h1>Horarios</h1>

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success">@TempData["Mensaje"]</div>
}

@if (ViewBag.Message != null)
{
    <div class="alert alert-danger">@ViewBag.Message</div>
}

<p>
    <a asp-action="Create" class="btn btn-primary">Crear Nuevo</a>
</p>
@if (Model != null)
{
    <table class="table">
        <thead>
            <tr>
                <th>
                    @Html.DisplayNameFor(model => model.Id)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.RutaNombre)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.DiasOperacion)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.HoraInicio)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.HoraFin)
                </th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        @Html.DisplayFor(model => item.Id)
                    </td>
                    <td>
                        @Html.DisplayFor(model => item.RutaNombre)
                    </td>
                    <td>
                        @Html.DisplayFor(model => item.DiasOperacion)
                    </td>
                    <td>
                        @Html.DisplayFor(model => item.HoraInicio)
                    </td>
                    <td>
                        @Html.DisplayFor(model => item.HoraFin)
                    </td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Editar</a>
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Detalles</a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Eliminar</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}