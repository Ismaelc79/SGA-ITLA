@using SGA.Application.DTOs.Horario
@model HorarioDto

@{
    ViewData["Title"] = "Eliminar";
}

<h1>Eliminar Horario</h1>

<h3 class="text-danger">¿Está seguro que desea eliminar este horario?</h3>

@if (ViewBag.Message != null)
{
    <div class="alert alert-danger">@ViewBag.Message</div>
}

<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Id)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Id)</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.RutaId)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.RutaId)</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.DiasOperacion)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.DiasOperacion)</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.HoraInicio)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.HoraInicio)</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.HoraFin)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.HoraFin)</dd>
    </dl>

    <form asp-action="Delete" asp-route-id="@Model.Id" method="post">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Eliminar" class="btn btn-danger" />
        <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
    </form>
</div>