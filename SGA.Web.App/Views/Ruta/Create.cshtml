@using SGA.Application.DTOs.Ruta
@model CreateRutaDto

@{
    ViewData["Title"] = "Crear Ruta";
}

<h1>Crear Ruta</h1>

<hr />
<div class="row">
    <div class="col-md-6">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group mb-3">
                <label asp-for="Nombre" class="control-label"></label>
                <input asp-for="Nombre" class="form-control" />
                <span asp-validation-for="Nombre" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="Descripcion" class="control-label"></label>
                <input asp-for="Descripcion" class="form-control" placeholder="Ej. Ruta Charles Origen Villa Mella" />
                <span asp-validation-for="Descripcion" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="EstadoRuta" class="control-label"></label>
                <input asp-for="EstadoRuta" class="form-control" />
                <span asp-validation-for="EstadoRuta" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="RutaOrigen" class="control-label"></label>
                <input asp-for="RutaOrigen" class="form-control" />
                <span asp-validation-for="RutaOrigen" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="RutaDestino" class="control-label"></label>
                <input asp-for="RutaDestino" class="form-control" />
                <span asp-validation-for="RutaDestino" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Crear" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
