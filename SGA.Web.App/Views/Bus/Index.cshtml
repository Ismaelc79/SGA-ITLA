@using SGA.Application.DTOs.Bus
@model IEnumerable<BusDto>

@{
    ViewData["Title"] = "Index";
}

<h1>Autobuses</h1>

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success">@TempData["Mensaje"]</div>
}

@if (ViewBag.Message != null)
{
    <div class="alert alert-danger">@ViewBag.Message</div>
}

<p>
    <a asp-action="Create" class="btn btn-primary">Crear Nuevo</a>
</p>
@if (Model != null)
{
    <table class="table">
        <thead>
            <tr>
                <th>
                    @Html.DisplayNameFor(model => model.ConductorNombre)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Placa)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Marca)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Modelo)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Capacidad)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.EstadoBus)
                </th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        @Html.DisplayFor(model => item.ConductorNombre)
                    </td>
                    <td>
                        @Html.DisplayFor(model => item.Placa)
                    </td>
                    <td>
                        @Html.DisplayFor(model => item.Marca)
                    </td>
                    <td>
                        @Html.DisplayFor(model => item.Modelo)
                    </td>
                    <td>
                        @Html.DisplayFor(model => item.Capacidad)
                    </td>
                    <td>
                        @Html.DisplayFor(model => item.EstadoBus)
                    </td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Editar</a>
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Detalles</a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Eliminar</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}