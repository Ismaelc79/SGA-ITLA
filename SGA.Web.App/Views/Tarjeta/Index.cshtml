@using SGA.Application.DTOs.TarjetaRecargable
@model IEnumerable<TarjetaRecargableDto>

@{
    ViewData["Title"] = "Index";
}

<h1>Tarjetas Recargables</h1>

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success">@TempData["Mensaje"]</div>
}

@if (ViewBag.Message != null)
{
    <div class="alert alert-danger">@ViewBag.Message</div>
}

<p>
    <a asp-action="Create" class="btn btn-primary">Crear Nueva</a>
</p>
@if (Model != null)
{
    <table class="table">
        <thead>
            <tr>
                <th>
                    @Html.DisplayNameFor(model => model.Id)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.EstudianteId)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.PagoId)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.MontoTarjeta)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.EstadoTarjeta)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.FechaVigenteInicio)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.FechaVigenteFin)
                </th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        @Html.DisplayFor(model => item.Id)
                    </td>
                    <td>
                        @Html.DisplayFor(model => item.EstudianteId)
                    </td>
                    <td>
                        @Html.DisplayFor(model => item.PagoId)
                    </td>
                    <td>
                        @Html.DisplayFor(model => item.MontoTarjeta)
                    </td>
                    <td>
                        @Html.DisplayFor(model => item.EstadoTarjeta)
                    </td>
                    <td>
                        @Html.DisplayFor(model => item.FechaVigenteInicio)
                    </td>
                    <td>
                        @Html.DisplayFor(model => item.FechaVigenteFin)
                    </td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Editar</a>
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Detalles</a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Eliminar</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}