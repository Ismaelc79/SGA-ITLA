@using SGA.Application.DTOs.TarjetaRecargable
@model TarjetaRecargableDto

@{
    ViewData["Title"] = "Eliminar";
}

<h1>Eliminar Tarjeta</h1>

<h3 class="text-danger">¿Está seguro que desea eliminar esta Tarjeta?</h3>

@if (ViewBag.Message != null)
{
    <div class="alert alert-danger">@ViewBag.Message</div>
}

<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Id)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Id)</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.EstudianteId)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.EstudianteId)</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.PagoId)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.PagoId)</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.MontoTarjeta)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.MontoTarjeta)</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.EstadoTarjeta)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.EstadoTarjeta)</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.FechaVigenteInicio)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.FechaVigenteInicio)</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.FechaVigenteFin)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.FechaVigenteFin)</dd>
    </dl>

    <form asp-action="Delete" asp-route-id="@Model.Id" method="post">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Eliminar" class="btn btn-danger" />
        <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
    </form>
</div>