@using SGA.Application.DTOs.Ticket
@model TicketDto

@{
    ViewData["Title"] = "Detalles";
}

<h1>Detalles del Ticket</h1>

<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Id)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Id)</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.EstudianteId)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.EstudianteId)</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.RutaId)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.RutaId)</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.ParadaId)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.ParadaId)</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.PagoId)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.PagoId)</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Tipo)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Tipo)</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.EstadoTicket)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.EstadoTicket)</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.FechaInicio)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.FechaInicio)</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.FechaCierre)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.FechaCierre)</dd>
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Editar</a>
    <a asp-action="Index" class="btn btn-secondary">Volver al listado</a>
</div>